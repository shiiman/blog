---
import BaseLayout from './BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'pages'>
}
const { entry } = Astro.props
const { title, excerpt, slug } = entry.data
---
<BaseLayout title={`${title} - shiimanblog`} description={excerpt}>
  <article class:list={['page', slug === 'profile' && 'page--profile']} data-pagefind-body>
    <h1>{title}</h1>
    <div class="content">
      <slot />
    </div>
    <slot name="after-content" />
  </article>
</BaseLayout>

<style>
  .page h1 { font-size: 1.8rem; margin: 0 0 1.5rem; }
  .content :global(h2) { margin-top: 2rem; }
  .content :global(img) { border-radius: 8px; }
  .page--profile .content :global(a:has(> img[alt="Bucket List Commit のアプリアイコン"])) {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .page--profile .content :global(a:has(> img[alt="Bucket List Commit のアプリアイコン"]):hover) {
    text-decoration: none;
  }
  .page--profile .content :global(img[alt="Bucket List Commit のアプリアイコン"]) {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
  }
</style>
